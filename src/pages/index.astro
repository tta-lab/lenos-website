---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HeroEditorial from "../components/HeroEditorial.astro";
import KeyDifferentiators from "../components/KeyDifferentiators.astro";
import InstallStrip from "../components/InstallStrip.astro";
import BenchmarkTable from "../components/BenchmarkTable.astro";
import PhilosophyBlock from "../components/PhilosophyBlock.astro";

const base = import.meta.env.BASE_URL;

const differentiators = [
  {
    marker: "i.",
    title: "Bash is all you need.",
    body: `Lenos keeps tools as CLIs. File edits are <code>src edit</code>,
      web lookup is <code>web search</code>, skills are found with
      <code>skill</code>, project context comes from <code>project</code>,
      and normal Unix tools still work. The model replies in Markdown and wraps
      shell calls in <code>&lt;run&gt;</code> blocks. No provider-specific
      schemas to track. No <code>tool_use_id</code> mismatches when the model
      drifts from the schema.<sup
      style="font-size:0.7em;color:var(--color-brand-gold);"><a
      href="https://github.com/anthropics/claude-code/issues/3886"
      style="color:inherit;border-bottom:none;">†</a></sup> And no
      <em>「please use parallel tool calls」</em> prompts the model ignores —
      in bash, parallel is just <code>cmd1 &amp; cmd2 &amp; wait</code>.`,
    caption: `† real-world examples:
      <a href="https://github.com/anthropics/claude-code/issues/3886">anthropics/claude-code #3886</a>
      (missing tool_result),
      <a href="https://github.com/ollama/ollama/issues/12395">ollama/ollama #12395</a>
      (Anthropic-compat backend pairing failure),
      <a href="https://agi-xiaobai-no1.github.io/posts/model-switching-tool-use-compatibility/">model-switching incompatibility</a>
      (Anthropic <code>tooluse_xxx</code> ↔ OpenAI <code>call_xxx</code> drift).
      Every framework that maintains a tool-call schema fights this.`,
  },
  {
    marker: "ii.",
    title: "Sandbox by default. No permission JSON.",
    body: `Lenos ships with the temenos sandbox enabled and auto-configured.
      Filesystem isolation comes for free. No <code>--yolo</code> flags to
      remember, no permission dialogs interrupting your flow, no hundred-line
      JSON to maintain across projects. The agent runs in a box; the box has
      the rights it needs; you don't think about it.`,
  },
  {
    marker: "iii.",
    title: "40%-60% fewer protocol tokens.",
    body: `Native tool calls spend tokens on JSON schemas, call IDs, argument
      wrappers, and pairing records. Lenos uses Markdown plus a small run block,
      cutting protocol token cost by 40%-60% in typical tool-heavy turns. The
      deeper bet is cache locality: stable prompt prefixes, compact runtime
      context, and a session journal that preserves continuity without dragging
      full history forward. Recent DeepSeek V4 Pro runs have been in the
      98-99% prompt-cache hit range.
      <em>「Perfection is achieved, not when there is nothing more to add, but
      when there is nothing left to take away.」</em> — Saint-Exupéry,
      <em>Terre des Hommes</em>, 1939.`,
  },
];

const installMethods = [
  {
    label: "macOS/Linux",
    command: "curl -fsSL https://github.com/tta-lab/lenos/releases/latest/download/install.sh | sh",
  },
];
---
<BaseLayout title="Lenos — a terminal AI runtime">
  <SiteHeader current="home" />
  <main id="main">
    <HeroEditorial
      statement={`Bash is <span class="mark">all you need</span>.`}
      subhead="A terminal AI runtime with a built-in sandbox, CLI-native tools, Markdown plus run blocks, and an agent journal built for cheap, cache-friendly long work."
      primaryHref={`${base}/docs/install`}
      primaryLabel="Install lenos →"
      secondaryHref="#philosophy"
      secondaryLabel="Read the philosophy →"
    />
    <KeyDifferentiators items={differentiators} />
    <InstallStrip methods={installMethods} />
    <BenchmarkTable limit={5} />
    <PhilosophyBlock />
  </main>
  <SiteFooter />
</BaseLayout>
